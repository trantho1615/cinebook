# Sao chep thanh .env roi dien gia tri that. File .env nam trong .gitignore.
#
#   cp .env.example .env
#
# Sinh bi mat bang lenh:  openssl rand -base64 48

# HS256 doi khoa toi thieu 256 bit (32 byte). Ngan hon thi ung dung khong khoi dong duoc.
CINEBOOK_JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-toi-thieu-32-byte

# Dung de xac thuc chu ky HMAC cua webhook thanh toan.
CINEBOOK_WEBHOOK_SECRET=thay-bang-chuoi-ngau-nhien-khac

# demo         nap lich chieu mau, bat cong thanh toan gia lap
# prod         nghiem ngat ve bi mat, khong nap du lieu mau
# prod,demo    ban demo cong khai: nghiem ngat ve bi mat NHUNG van co lich chieu de bam thu
SPRING_PROFILES_ACTIVE=demo
